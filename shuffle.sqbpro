<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="shuffle.sqlite3" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2361"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="survival_mode" custom_title="0" dock_id="5" table="4,13:mainsurvival_mode"/><dock_state state=""/><default_encoding codec=""/><browse_table_settings><table schema="main" name="survival_mode" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="39"/><column index="2" value="135"/><column index="3" value="91"/><column index="4" value="71"/><column index="5" value="121"/><column index="6" value="127"/><column index="7" value="98"/><column index="8" value="46"/><column index="9" value="73"/><column index="10" value="114"/><column index="11" value="135"/><column index="12" value="70"/><column index="13" value="68"/><column index="14" value="94"/><column index="15" value="300"/><column index="16" value="67"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">SELECT id, stage_number, stage, starting_moves, moves, stage_time, won_stage, current_team
FROM survival_mode
ORDER BY ROWID ASC;


SELECT * 
FROM survival_mode
WHERE last_run_stage = 1
ORDER BY ROWID DESC;

SELECT id FROM (
SELECT id, COUNT(*) as record_numbers
FROM survival_mode
GROUP BY id
)
WHERE record_numbers &gt; 60</sql><sql name="SQL 2">DELETE FROM survival_mode
WHERE id IN (
    SELECT id FROM (
        SELECT id, COUNT(*) as record_numbers
        FROM survival_mode
        GROUP BY id
    ) 
    WHERE record_numbers &gt; 60
);</sql><sql name="SQL 4*">SELECT id, stage_number, stage, stage_text, starting_moves, moves, stage_time, accumulated_time, won_stage, current_team
FROM survival_mode
-- WHERE stage = &quot;Salamence&quot;
ORDER BY ROWID DESC
LIMIT 2000;</sql><sql name="SQL 5">SELECT id, stage_number, stage, starting_moves, moves, stage_time, won_stage, accumulated_time, current_team
FROM survival_mode
WHERE 1 = 1
AND last_run_stage = 1
ORDER BY ROWID DESC;</sql><sql name="SQL 6">SELECT *
FROM survival_mode
-- WHERE id = &quot;2024-11-04 17:50:45.217592&quot;
ORDER BY moves desc

-- UPDATE survival_mode
-- SET id = substr(id, 1, 4) || '-' ||
--                   substr(id, 6, 2) || '-' ||
--                   substr(id, 9, 2) || ' ' ||
--                   substr(id, 12, 2) || ':' ||
--                   substr(id, 15, 2);</sql><sql name="SQL 7*">SELECT 
    DATE(id) AS date,
    current_team,
    SUM(last_run_stage) AS total_complete_runs,
	SUM(CASE WHEN stage_number = 50 AND won_stage = 1 THEN 1 ELSE 0 END) AS won_stage_50,
    SUM(CASE WHEN stage_number = 55 AND won_stage = 1 THEN 1 ELSE 0 END) AS won_stage_55,
    SUM(CASE WHEN stage_number = 	60 AND won_stage = 1 THEN 1 ELSE 0 END) AS won_stage_60,
	COUNT(*) as daily_total_stages_won
FROM 
    survival_mode
GROUP BY 
    DATE(id), current_team
ORDER BY 
    DATE(id) DESC, current_team;</sql><sql name="SQL 7">SELECT id, stage_number, stage, starting_moves, moves, stage_time, won_stage, accumulated_time, current_team
FROM survival_mode
WHERE 1 = 1
AND moves &gt; 10
ORDER BY moves DESC;</sql><current_tab id="2"/></tab_sql></sqlb_project>
